# Your Gemini API key from https://aistudio.google.com/apikey
# Keep it secret. It stays on the server and is never sent to the phone.
GEMINI_API_KEY=

# Optional: a code that users must enter once before talking.
# Recommended when you share the link, so strangers cannot use your key.
ACCESS_CODE=

# Optional: Live model and voice. Leave empty to use the defaults.
GEMINI_MODEL=gemini-3.8-live
GEMINI_VOICE=
