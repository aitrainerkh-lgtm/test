{
  "lines": {
    "l1": {
      "start": 0.7,
      "end": 4.153333333333333,
      "duration": 3.453333333333333,
      "text": "Ask a chatbot a question, and you get an answer."
    },
    "l2": {
      "start": 4.3933333333333335,
      "end": 7.846666666666668,
      "duration": 3.4533333333333336,
      "text": "But what if AI could actually do the work for you?"
    },
    "l3": {
      "start": 8.086666666666668,
      "end": 9.473333333333334,
      "duration": 1.3866666666666667,
      "text": "That's an AI agent."
    },
    "l4": {
      "start": 10.193333333333335,
      "end": 18.380000000000003,
      "duration": 8.186666666666666,
      "text": "An AI agent uses a large language model as its brain, to plan, decide, and take action toward a goal, on its own."
    },
    "l5": {
      "start": 18.980000000000004,
      "end": 20.56666666666667,
      "duration": 1.5866666666666664,
      "text": "It starts with a goal."
    },
    "l6": {
      "start": 20.76666666666667,
      "end": 25.74666666666667,
      "duration": 4.9799999999999995,
      "text": "Say: find three suppliers, compare prices, and email me a summary."
    },
    "l7": {
      "start": 26.78666666666667,
      "end": 30.773333333333337,
      "duration": 3.986666666666667,
      "text": "First, the agent thinks, breaking the goal into steps."
    },
    "l8": {
      "start": 31.053333333333338,
      "end": 35.23333333333334,
      "duration": 4.180000000000001,
      "text": "Then it acts, using tools: web search, files, email."
    },
    "l9": {
      "start": 35.51333333333334,
      "end": 39.23333333333334,
      "duration": 3.72,
      "text": "It observes the result, and decides what to do next."
    },
    "l10": {
      "start": 39.55333333333334,
      "end": 44.02666666666668,
      "duration": 4.473333333333334,
      "text": "Think. Act. Observe. Repeat, until the job is done."
    },
    "l11": {
      "start": 44.66666666666668,
      "end": 53.38000000000001,
      "duration": 8.713333333333333,
      "text": "Every agent combines four parts: a model to reason, memory for context, tools to act, and instructions to stay on track."
    },
    "l12": {
      "start": 53.94000000000001,
      "end": 58.40000000000001,
      "duration": 4.46,
      "text": "Chatbots answer. Agents get work done, with you in control."
    }
  },
